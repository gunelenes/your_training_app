{
  "expo": {
    "name": "Your Workouts",
    "slug": "yourtrainingapp",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-square.png",
    "scheme": "yourtrainingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.enesgunel.yourtrainingapp",
      "supportsTablet": false,
      "icon": "./assets/images/app-icon-square.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.enesgunel.yourtrainingapp",
      "icon": "./assets/images/app-icon-square.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon-square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Antrenmanlarına ve hareketlerine görsel eklemek için fotoğraflarına erişim izni gerekiyor.",
          "cameraPermission": "Antrenmanlarına ve hareketlerine fotoğraf çekerek görsel eklemek için kamera izni gerekiyor.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "0257c49a-a3e6-475e-addb-62d3cb053cc9"
      }
    },
    "owner": "enesgunel"
  }
}
