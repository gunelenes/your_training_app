{
  "expo": {
    "name": "Your Workouts",
    "slug": "yourtrainingapp",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "yourtrainingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "bundleIdentifier": "com.enesgunel.yourtrainingapp",
      "supportsTablet": false,
      "buildNumber": "6",
      "icon": "./assets/images/app-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.enesgunel.yourtrainingapp",
      "versionCode": 5,
      "icon": "./assets/images/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#000000"
      }
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      "react-native-localize"
    ],

    "extra": {
      "eas": {
        "projectId": "0257c49a-a3e6-475e-addb-62d3cb053cc9"
      }
    },

    "owner": "enesgunel"
  }
}
